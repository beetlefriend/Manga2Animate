# ---------- Credentials ----------
GEMINI_API_KEY=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# seedance
ARK_API_KEY=
# wan
DASHSCOPE_API_KEY=
# minimax-api
MINIMAX_API_KEY=
# image hosting for seedance / wan
IMGBB_API_KEY=


# ---------- Storyboard pipeline ----------
TEXT_MODEL=gemini-3.7-flash
IMAGE_MODEL=gemini-3.1-flash-image

NUM_SCRIPTS=3
NUM_CLIPS=6
NUM_STORYBOARDS=3
NUM_ITERATIONS=2

# gemini | flux2
STORYBOARD_BACKEND=gemini


# ---------- Creative Expansion (Sakuga Kit) ----------
# Off by default: the paper's faithful pipeline runs unchanged. `--creative` on
# run_all.py / full_pipeline.py turns it on for one run; true turns it on always.
CREATIVE_MODE=false
# conservative | balanced | aggressive  (aliases: faithful, sakuga)
#   conservative  6 shots  same count as panels, up to 2 re-angled, no inserts
#   balanced      9 shots  every panel kept + reaction / impact / establishing inserts
#   aggressive   12 shots  full sakuga: crash zooms, whip pans, orbitals, Dutch angles
CREATIVITY_LEVEL=balanced
# Override the shot count per level (rounded up to a full 3-column storyboard row).
# CREATIVE_SHOTS_CONSERVATIVE=6
# CREATIVE_SHOTS_BALANCED=9
# CREATIVE_SHOTS_AGGRESSIVE=12
# CREATIVE_MAX_INSERTS=
# CREATIVE_MAX_REANGLES=
# Continuity Reviewer passes over the expanded shot list (create -> review -> revise ...).
# 1 = review once, drop what cannot be fixed; 2 = review, revise, review again.
CREATIVE_REVIEW_ROUNDS=2
# Creative storyboard candidates (pairwise-reviewed) and the Gemini image size.
# 9- and 12-panel sheets need 2K to keep faces readable.
CREATIVE_NUM_STORYBOARDS=2
CREATIVE_IMAGE_SIZE=2K
# Free-text direction appended to the Shot Expansion Agent's brief, e.g.
# "keep the camera low for the whole fight; no orbital moves".
# CREATIVE_NOTES=

# Character model sheets (turnaround + expressions + details) generated from the
# panels and the shipped reference, reviewed, and fed to the storyboard, creative
# and video stages. auto = only when the target ships a single composite ref.png.
CHARACTER_SHEETS=auto
CHARACTER_SHEET_CANDIDATES=2
CHARACTER_SHEET_ASPECT=16:9
CHARACTER_SHEET_SIZE=2K


# ---------- Video generation ----------
VIDEO_REVIEW_MODEL=gemini-3.1-pro-preview

# exact version each -m submits (anisora has none)
SEEDANCE_MODEL=dreamina-seedance-2-0-260128
WAN_MODEL=wan2.7-i2v
MINIMAX_MODEL=MiniMax-H3
MINIMAX_LOCAL_MODEL=MiniMaxAI/MiniMax-H3

# model used when -m is omitted
VIDEO_GENERATION_MODEL=dreamina-seedance-2-0-260128

# --- Creative video knobs (create_video.py --creative) ---
# auto | ref | i2v. auto: aggressive shot lists go i2v on models that take a first
# frame (one clip per shot, each with its own camera move); everything else keeps
# the reference-conditioned route, segmented when the list is longer than
# VIDEO_MAX_SHOTS_PER_SEGMENT.
VIDEO_ROUTE=auto
# Seconds requested per shot on the ref route (9 shots x 2.5s -> 22s, clamped to
# the model's maximum) and the longest single request each hosted model accepts.
VIDEO_SECONDS_PER_SHOT=2.5
VIDEO_MAX_SHOTS_PER_SEGMENT=6
SEEDANCE_MAX_DURATION=15
MINIMAX_MAX_DURATION=15
# Send the character model sheets (or the shipped ref) as extra reference images
# on backends that accept them (seedance, minimax-api, higgsfield, manual).
# Default: on in --creative, off otherwise.
# VIDEO_CHARACTER_REFS=true
SEEDANCE_MAX_EXTRA_REFS=4
MINIMAX_MAX_EXTRA_REFS=3
# SEEDANCE_RESOLUTION=720p

# --- Higgsfield (-m higgsfield): one API in front of Seedance 2.x / Kling / MiniMax
# H3 / Veo / Wan. Keys from the Higgsfield console. The model path and the JSON
# body come from the model's page on docs.higgsfield.ai; placeholders {prompt}
# {image_url} {duration} {extra_refs} are filled in by src/video_models.py.
# HIGGSFIELD_API_KEY=
# HIGGSFIELD_API_SECRET=
# HIGGSFIELD_MODEL_PATH=
# HIGGSFIELD_BODY_TEMPLATE={"prompt": {prompt}, "image_url": {image_url}, "duration": {duration}, "aspect_ratio": "16:9", "image_urls": {extra_refs}}
# HIGGSFIELD_ROUTE=ref
# HIGGSFIELD_MAX_DURATION=15

# --- Manual (-m manual): write manifest.json instead of calling a provider, generate
# the clips anywhere (web UI, Higgsfield MCP in an agent session), drop them at the
# listed paths and re-run with --auto-resume.
# MANUAL_ROUTE=i2v
# MANUAL_MAX_DURATION=30

# self-hosted, optional — these are the values src/video_models.py already
# defaults to, spelled out so they are editable without reading the code.
# OSVG_MODELS_DIR is relative to the repo root, like every other path here.
OSVG_MODELS_DIR=opensource_video_generator/models
MINIMAX_LOCAL_PORT=30011
MINIMAX_LOCAL_STEPS=50
ANISORA_GPU=0,1
ANISORA_FRAME_NUM=81
ANISORA_SIZE=1280*720
ANISORA_STEPS=8
ANISORA_ENV=anisora3.2


# ---------- FLUX.2 backend (STORYBOARD_BACKEND=flux2) ----------
FLUX2_CONDA_ENV=sb_diffusers
FLUX2_MODEL_ID=black-forest-labs/FLUX.2-dev
FLUX2_NUM_VARIANTS=3
FLUX2_PANEL_WIDTH=768
FLUX2_PANEL_HEIGHT=640
FLUX2_NUM_INFERENCE_STEPS=28
FLUX2_GUIDANCE_SCALE=4.0
FLUX2_WORKER_TIMEOUT=10800

# resident  = load the text encoder, encode every panel prompt once, free it, then
#             keep transformer+vae (~65GB) on one card for the whole run. Needs a
#             GPU with ~75GB free. No per-call weight streaming -> much faster.
# cpu_offload = keep ~113GB in CPU RAM and stream submodules to the GPU on every
#             pipe() call. Needs ~60GB free VRAM but moves ~2TB over PCIe for a
#             6-panel x 3-variant job. Fallback for smaller cards.
FLUX2_OFFLOAD_MODE=resident
# Which GPU the worker gets, as a CUDA_VISIBLE_DEVICES value. "auto" picks the
# least-loaded card. Set this explicitly on a shared machine: FLUX.2-dev needs most
# of a 97GB card, and another process on the same GPU is the most common failure.
FLUX2_CUDA_DEVICE=auto
# A panel's variants share a prompt and COULD be generated in one batched call, but
# measured on this machine the GPU is already compute-saturated per image (82s/image
# whether batch=1 or batch=3) -- batching buys no wall-clock time, only costs more
# peak VRAM (63.6GB -> 72.0GB at batch=3) for no payoff. Default 1; raise only if a
# future GPU/resolution turns out not to be compute-saturated.
FLUX2_BATCH_VARIANTS=1
# Abort before loading weights if the chosen GPU has less than this much free.
# Empty = mode-specific default (75GB resident / 60GB cpu_offload).
# FLUX2_MIN_FREE_VRAM_GB=
# Stop the run after this many consecutive image failures instead of grinding
# through every remaining panel once the GPU is clearly out of memory.
FLUX2_MAX_CONSECUTIVE_FAILURES=2
# The worker never re-validates an already-complete local cache against
# huggingface.co (that round-trip was measured hanging 7+ minutes on one real
# run). Set to false only for a first-time download onto a fresh/incomplete
# cache -- and raise FLUX2_WORKER_TIMEOUT for that one run.
FLUX2_HF_OFFLINE=true
# Absolute path to the conda binary. Only needed when conda is not on PATH, which
# is common in non-interactive shells (conda's shell init does not run there).
# FLUX2_CONDA_EXE=
# HF_TOKEN=
# Put this on LOCAL disk, not an NFS mount -- from_pretrained()'s weight loading
# is lazy (mmap-based), so the real ~105GB read happens later, tensor by tensor,
# when the worker does pipe.text_encoder.to("cuda"). Over NFS that measured
# 71.5MB/s on one real run (~10 min for the text encoder alone, every single
# run); the same read from local NVMe took 82.9s. See
# opensource_backends/flux2/README.md "Loading time" for the full measurement.
# FLUX2_HF_HOME=
# Deprecated, use FLUX2_OFFLOAD_MODE. Still honoured if FLUX2_OFFLOAD_MODE is unset:
# true -> cpu_offload, false -> resident (it used to mean pipe.to("cuda"), which
# cannot work for a 113GB model on a 97GB card).
# FLUX2_CPU_OFFLOAD=true
